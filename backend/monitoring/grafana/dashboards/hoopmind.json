          "mode": "multi"
        }
      },
      "description": "ok, ou le code d'erreur : MODEL_NOT_TRAINED, NO_TEAM_FORM, SEASON_NOT_FOUND."
    },
    {
      "type": "timeseries",
      "title": "Durée d'une prédiction (p95)",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hoopmind_ml_predictions_seconds_bucket{application=\"hoopmind\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
