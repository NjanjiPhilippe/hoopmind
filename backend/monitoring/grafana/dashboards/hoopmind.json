        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Lecture de la forme des équipes en base, puis calcul de la régression logistique en Java."
    },
    {
      "type": "table",
      "title": "Version du modèle servie",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (model_version) (increase(hoopmind_ml_predictions_seconds_count{application=\"hoopmind\",outcome=\"ok\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "model_version": "Version",
              "Value": "Prédictions"
            }
          }
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Répartition des probabilités prédites (victoire à domicile)",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (le) (increase(hoopmind_ml_home_win_probability_bucket{application=\"hoopmind\"}[$__range]))",
          "legendFormat": "{{le}}",
          "instant": true,
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "displayMode": "basic",
        "showUnfilled": false
      },
      "description": "Nombre de prédictions par tranche de probabilité sur la période. Une répartition qui se déplace sans nouvel entraînement signale une dérive des données."
    },
    {
      "type": "stat",
      "title": "Probabilité moyenne (domicile)",
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 41
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(hoopmind_ml_home_win_probability_sum{application=\"hoopmind\"}[$__range])) / sum(increase(hoopmind_ml_home_win_probability_count{application=\"hoopmind\"}[$__range]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Sur les dernières saisons, l'équipe à domicile gagne environ 55 % des matchs : une moyenne très éloignée mérite un coup d'œil."
    }
