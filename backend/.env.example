# Copier en .env puis remplir. Ne jamais commiter le fichier .env.

# Base PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/hoopmind
DB_USERNAME=hoopmind
DB_PASSWORD=change-me

# Clé de signature des JWT : au moins 256 bits encodés en Base64.
# Générer avec : openssl rand -base64 48
JWT_SECRET=

# Premier administrateur (créé au démarrage si aucun administrateur n'existe). Mot de passe de 12 caractères au
# moins, sinon l'API refuse de démarrer. Sur un serveur public, préférer un autre nom que « admin ».
HOOPMIND_ADMIN_USERNAME=admin
HOOPMIND_ADMIN_EMAIL=admin@hoopmind.local
HOOPMIND_ADMIN_PASSWORD=

# Le cookie de rafraîchissement n'est envoyé qu'en HTTPS. Le passer à false seulement en local, en HTTP sur une
# autre adresse que localhost (les navigateurs traitent localhost comme sécurisé). Jamais sur un serveur public.
REFRESH_COOKIE_SECURE=true

# Démonstration sans compte (bouton « Essayer sans compte ») : compte partagé en lecture seule.
DEMO_ENABLED=false
# HOOPMIND_DEMO_USERNAME=demo

# Spark : local[*] par défaut, ou spark://spark-master:7077 avec docker compose --profile spark
SPARK_ENABLED=true
SPARK_MASTER=local[*]

# Données NBA : base SQLite de Wyatt Walsh (Kaggle wyattowalsh/basketball), téléchargée par scripts/download-nba-database.sh
NBA_DATABASE_PATH=data/nba.sqlite
# Clé d'API Kaggle (https://www.kaggle.com/settings > API > Create New Token) : permet au serveur de télécharger
# la base lui-même depuis la page « Données » de l'administration. Ne jamais la versionner.
KAGGLE_USERNAME=
KAGGLE_KEY=
# Saisons récentes : dossier où déposer Games.csv et TeamStatistics.csv (Kaggle eoinamoore/historical-nba-data-and-player-box-scores)
EOINMOORE_DATA_DIR=data/eoinamoore
# Nombre de saisons importées (les plus récentes) et nombre de saisons utilisées pour entraîner le modèle
NBA_IMPORT_SEASONS=10
ML_TRAINING_SEASONS=5
# Lancer l'import au démarrage (sinon : page « Données » de l'administration)
NBA_IMPORT_ON_STARTUP=false

# Explication des prédictions par un LLM (facultatif ; sans réglage, l'explication est rédigée sans LLM).
# Gemini, offre gratuite (clé sur https://aistudio.google.com/apikey) :
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=
# Groq, offre gratuite : LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=llama-3.3-70b-versatile
# Ollama en local, sans clé : LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=llama3.2
# Claude (payant) : LLM_PROVIDER=anthropic, LLM_MODEL=claude-haiku-5-5, LLM_API_KEY=
LLM_PROVIDER=none
# Appels au LLM par jour, tous utilisateurs confondus (au-delà : explication sans LLM). À régler sous le quota
# gratuit du fournisseur, visible dans sa console.
# LLM_MAX_CALLS_PER_DAY=200

# E-mail (facultatif ; sans SPRING_MAIL_HOST l'envoi d'e-mails est désactivé)
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=

# Monitoring (profil « monitoring » du docker-compose) : mot de passe de Prometheus pour lire /actuator/prometheus.
# Sans valeur, l'endpoint reste fermé. Générer par exemple avec : openssl rand -base64 24
METRICS_PASSWORD=
# Mot de passe de l'administrateur Grafana (admin par défaut, à changer à la première connexion)
# GRAFANA_ADMIN_PASSWORD=

# Journal d'audit : durée de conservation (format Spring : 90d, 365d…)
# AUDIT_RETENTION=365d
