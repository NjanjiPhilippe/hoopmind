# Copier en .env puis remplir. Ne jamais commiter le fichier .env.

# Base PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/hoopmind
DB_USERNAME=hoopmind
DB_PASSWORD=change-me

# Clé de signature des JWT : au moins 256 bits encodés en Base64.
# Générer avec : openssl rand -base64 48
JWT_SECRET=

# Premier administrateur (créé au démarrage si aucun administrateur n'existe)
HOOPMIND_ADMIN_USERNAME=admin
HOOPMIND_ADMIN_EMAIL=admin@hoopmind.local
HOOPMIND_ADMIN_PASSWORD=

# En local sans HTTPS, le cookie de rafraîchissement ne doit pas exiger « Secure »
# (sauf si le frontend est servi sur localhost, que les navigateurs traitent comme sécurisé).
REFRESH_COOKIE_SECURE=false

# Spark : local[*] par défaut, ou spark://spark-master:7077 avec docker compose --profile spark
SPARK_ENABLED=true
SPARK_MASTER=local[*]

# Données NBA : base SQLite de Wyatt Walsh (Kaggle wyattowalsh/basketball), téléchargée par scripts/download-nba-database.sh
NBA_DATABASE_PATH=data/nba.sqlite
# Nombre de saisons importées (les plus récentes) et nombre de saisons utilisées pour entraîner le modèle
NBA_IMPORT_SEASONS=10
ML_TRAINING_SEASONS=5
# Lancer l'import au démarrage (sinon : POST /api/v1/admin/imports/nba-database en administrateur)
NBA_IMPORT_ON_STARTUP=false

# E-mail (facultatif ; sans SPRING_MAIL_HOST l'envoi d'e-mails est désactivé)
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
